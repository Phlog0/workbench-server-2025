{
    "name": "server",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build && tsc-alias",
        "start:prod": "node dist/main.js",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "typecheck": "tsc --noEmit ",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "generate-jwt-secret": "node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\"",
        "generate:secret": "ts-node src/shared/lib/generate-crypto-keys.ts",
        "prisma:reset": "prisma migrate reset",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@nestjs-modules/mailer": "^2.3.7",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^11.1.28",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.28",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mapped-types": "^2.1.1",
        "@nestjs/platform-express": "^11.1.28",
        "@nestjs/platform-socket.io": "^11.1.28",
        "@nestjs/swagger": "^11.4.6",
        "@nestjs/websockets": "^11.1.28",
        "@prisma/client": "^7.9.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/nodemailer": "^7.0.12",
        "@types/pg": "^8.20.0",
        "@willsoto/nestjs-prometheus": "^6.1.0",
        "axios": "^1.18.1",
        "bcryptjs": "^3.0.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "nodemailer": "^8.0.11",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "uuid": "^13.0.2",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.28",
        "@prisma/adapter-pg": "^7.9.0",
        "@types/express": "^4.17.25",
        "@types/jest": "^29.5.14",
        "@types/multer": "^2.2.0",
        "@types/node": "^20.19.43",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jiti": "^2.7.0",
        "lint-staged": "^17.2.0",
        "pg": "^8.22.0",
        "prettier": "^3.9.6",
        "prisma": "^7.9.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.1",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
